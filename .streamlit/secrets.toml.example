# Локально этот файл не читается напрямую (приложение берёт ключ из
# .env через python-dotenv) — он существует как ШАБЛОН для деплоя на
# Streamlit Community Cloud: Settings -> Secrets в дашборде приложения,
# вставить содержимое ниже (со своим настоящим ключом) как есть.
#
# Без ключа приложение тоже работает — DistanceMatrixBuilder уходит в
# haversine-фолбэк (см. README, раздел «Установка»).

ORS_API_KEY = "твой-ключ-openrouteservice"
